# Copy this file to .env.local and fill in the values.
#
# .env.local is git-ignored. Never commit real keys, and never paste a
# service role key into a client component or a NEXT_PUBLIC_ variable.
#
# Generate the two secrets with:
#   openssl rand -base64 32

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project settings -> API in the Supabase dashboard.
# The URL looks like https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon/public key. Safe to expose to the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service role key. Bypasses Row Level Security entirely.
# Server-side only. Used by the auth, profile and file routes under app/api.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Secrets used by lib/crypto.ts and lib/jwt.ts
# ---------------------------------------------------------------------------
# Key used to encrypt document titles, contents, passwords and attachment
# filenames at rest (lib/crypto.ts). Changing it makes existing encrypted
# documents unreadable.
ENCRYPTION_KEY=replace-with-a-32-byte-random-string

# Key used to sign session tokens (lib/jwt.ts).
JWT_SECRET=replace-with-a-32-byte-random-string

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Search console verification tokens rendered into <meta> tags (app/layout.tsx).
# Leave unset to omit the corresponding tag.
# GOOGLE_SITE_VERIFICATION=
# YANDEX_SITE_VERIFICATION=
