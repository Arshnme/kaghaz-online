# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# Next.js
/.next/
/out/
next-env.d.ts

# Production builds
/build
/dist

# Environment files
#
# Everything that can hold a secret is ignored, including .env.local,
# .env.development.local and .env.production.local. The example file is
# explicitly re-included so it can be committed without any real values.
.env
.env.*
!.env.example

# Vercel
.vercel

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# TypeScript
*.tsbuildinfo

# Database dumps and local data
*.dump
*.sql.gz
*.sqlite
*.sqlite3
*.db

# Test output
/coverage
/test-results
/playwright-report

# Editor and OS junk
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
.idea

# Local tooling
.eslintcache
